=begin

  Brief stay-then-quit helper for headless daily login touches.
  Started via: lich --login CHAR --headless auto --start-scripts=login_touch

  Waits until the character is fully in the game, stays STAY_SECONDS, then QUIT.

  Usage:
    ;login_touch           - stay then quit (default 20s)
    ;login_touch 30        - stay 30 seconds then quit
    ;login_touch help

       creator: loraque (loraque@gmail.com)
        author: loraque (loraque@gmail.com)
          game: Gemstone
          tags: login, utility, logout
      required: Lich >= 5.12.0
       version: 0.1.0

  changelog:
    0.1.0 (2026-10-10)
      initial: wait for in-game, sleep, quit

=end

DEFAULT_STAY = 20

if Script.current.vars[1].to_s =~ /^help$/i
  respond "Usage: ;login_touch [seconds]  (default #{DEFAULT_STAY})"
  exit
end

stay = Script.current.vars[1].to_i
stay = DEFAULT_STAY if stay < 1

echo "login_touch: waiting for in-game prompt…"

# Room title signals we are past character select and into the world.
deadline = Time.now + 120
loop do
  begin
    room = XMLData.room_title.to_s
    break if !room.empty? && room !~ /Character\s*Manager|Character\s*Select|Selecting/i
  rescue StandardError
    # still booting
  end
  if Time.now >= deadline
    echo "login_touch: timed out waiting for room — quitting anyway"
    do_client('quit')
    exit
  end
  sleep 0.5
end

echo "login_touch: in game (#{XMLData.room_title}) — staying #{stay}s"
sleep stay
echo "login_touch: exiting"
begin
  do_client('exit')
rescue StandardError
  nil
end
sleep 0.3
begin
  fput 'exit'
rescue StandardError
  nil
end
sleep 0.3
begin
  do_client('quit')
rescue StandardError
  nil
end
exit
