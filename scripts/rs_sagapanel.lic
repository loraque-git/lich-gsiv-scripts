=begin

  rs_sagapanel.lic

  Tiny always-on Saga lamp for Weapon Technique Radial Sweep.
  Lights READY only when a reaction trigger is up and the technique
  is off cooldown. Uses the same Buffs / Cooldowns dialogs as Saga Timers.

  Usage:
    ;rs                      - via rs.lic launcher
    ;rs_sagapanel            - this script directly

  Commands:
    *rs help                 - This command list (story window)
    *rs fire                 - weapon radialsweep (also click READY)
    *rs status               - Current lamp state

  States:
    READY   - Recent Evasion/Block/Parry (or opportunity line) AND no CD
    TRIG    - trigger up, but Radial Sweep still on cooldown
    CD Ns   - on cooldown, no trigger
    --      - idle

       creator: loraque (loraque@gmail.com)
        author: loraque (loraque@gmail.com)
          game: Gemstone
          tags: saga, frontend, panel, combat, weapon, radialsweep
      required: Lich >= 5.12.0
       version: 0.1.0

  changelog:
    0.1.0 (2026-10-22)
      initial READY lamp from Effects::Buffs + Effects::Cooldowns
      story latch for "You could use this opportunity to Radial Sweep!"

=end

no_kill_all

module RsPanel
  extend self
  include Lich::Common if defined?(Lich::Common)

  DIALOG_ID = 'RsPanel'
  PANEL_WIDTH = 150
  ROW_HEIGHT = 18
  BTN_HEIGHT = 20

  COOLDOWN_RX = /Radial Sweep/i
  TRIGGER_BUFF_RX = /Recent (?:Parry|Block|Evasion)/i
  OPPORTUNITY_RX = /You could use this opportunity to Radial Sweep!/i
  USED_RX = /Crouching low, you sweep your .+ in a broad arc!/
  # Keep story-latch trigger briefly if Buffs dialog is slow/missing.
  OPPORTUNITY_LATCH_SECS = 20.0

  class << self
    attr_accessor :dirty, :pending_cmd, :opportunity_until, :last_state
  end

  def self.story_echo(line)
    text = line.to_s.sub(/\A\[lich\]\s*/i, '')
    echo "[lich] #{text}"
  end

  def self.sanitize_xml(value)
    value.to_s.gsub('&', '&amp;').gsub('<', '&lt;').gsub('>', '&gt;').gsub("'", '&apos;').gsub('"', '&quot;')
  end

  def self.widget(tag, attrs)
    parts = attrs.map { |k, v| "#{k}='#{sanitize_xml(v)}'" }
    "<#{tag} #{parts.join(' ')} />"
  end

  def self.open_dialog_xml
    "<closeDialog id='#{DIALOG_ID}'/><openDialog type='dynamic' id='#{DIALOG_ID}' title='RS' target='#{DIALOG_ID}' scroll='none' location='main' resident='true'><dialogData id='#{DIALOG_ID}'></dialogData></openDialog>"
  end

  def self.effects_available?
    defined?(Effects::Buffs) && defined?(Effects::Cooldowns)
  end

  def self.cooldown_active?
    return false unless effects_available?
    Effects::Cooldowns.active?(COOLDOWN_RX)
  end

  def self.cooldown_secs_left
    return 0 unless effects_available?
    mins = Effects::Cooldowns.time_left(COOLDOWN_RX).to_f
    return 0 if mins <= 0
    (mins * 60.0).ceil
  end

  def self.buff_trigger_active?
    return false unless effects_available?
    Effects::Buffs.active?(TRIGGER_BUFF_RX)
  end

  def self.opportunity_latched?
    t = opportunity_until.to_f
    t > Time.now.to_f
  end

  def self.trigger_active?
    buff_trigger_active? || opportunity_latched?
  end

  # :ready, :trig_cd, :cd, :idle
  def self.state
    trig = trigger_active?
    cd = cooldown_active?
    if trig && !cd
      :ready
    elsif trig && cd
      :trig_cd
    elsif cd
      :cd
    else
      :idle
    end
  end

  def self.state_label
    case state
    when :ready then 'READY'
    when :trig_cd then "TRIG CD #{cooldown_secs_left}s"
    when :cd then "CD #{cooldown_secs_left}s"
    else '--'
    end
  end

  def self.observe_downstream(server_string)
    line = server_string.to_s
    if line =~ OPPORTUNITY_RX
      self.opportunity_until = Time.now.to_f + OPPORTUNITY_LATCH_SECS
      self.dirty = true
    elsif line =~ USED_RX
      self.opportunity_until = nil
      self.dirty = true
    elsif line =~ /Radial Sweep is ready for use/i || line =~ /Radial Sweep is still in cooldown/i
      self.dirty = true
    end
    server_string
  end

  def self.fire!
    fput 'weapon radialsweep'
    self.opportunity_until = nil
    self.dirty = true
    'weapon radialsweep'
  end

  def self.status_lines
    [
      "rs lamp: #{state_label}",
      "  trigger buff: #{buff_trigger_active? ? 'yes' : 'no'}",
      "  opportunity latch: #{opportunity_latched? ? 'yes' : 'no'}",
      "  cooldown: #{cooldown_active? ? "#{cooldown_secs_left}s" : 'no'}"
    ]
  end

  def self.help_lines
    [
      'rs lamp (Radial Sweep):',
      '  READY = reaction trigger + off cooldown',
      '  Click READY or *rs fire -> weapon radialsweep',
      '  *rs status | *rs help'
    ]
  end

  def self.build_dialog
    st = state
    label = state_label
    w = PANEL_WIDTH
    y = 0
    out = String.new("<dialogData id='#{DIALOG_ID}' clear='t'>")
    out << widget('label', id: 'rs_title', value: 'Radial Sweep', left: 2, top: y, width: w - 4, height: ROW_HEIGHT)
    y += ROW_HEIGHT
    if st == :ready
      out << widget('link', id: 'rs_lamp', value: label, cmd: '*rs fire',
                    left: 2, top: y, width: w - 4, height: BTN_HEIGHT)
    else
      out << widget('label', id: 'rs_lamp', value: label, left: 2, top: y, width: w - 4, height: ROW_HEIGHT)
    end
    out << '</dialogData>'
    out
  end

  def self.handle_command(raw)
    cmd = raw.to_s.strip.sub(/\A<c>/i, '')
    cmd = cmd.sub(/\A\*rs\s+/i, '')
    cmd = 'help' if cmd.empty? || cmd =~ /\Ahelp\z/i
    msgs = []
    case cmd
    when /\Ahelp\z/i
      msgs.concat(help_lines)
    when /\Astatus\z/i
      msgs.concat(status_lines)
    when /\Afire\z/i
      fire!
      msgs << 'rs: weapon radialsweep'
    else
      msgs << "rs: unknown #{cmd.inspect} - *rs help"
    end
    msgs
  end
end

# --- boot ---
RsPanel.dirty = false
RsPanel.pending_cmd = nil
RsPanel.opportunity_until = nil
RsPanel.last_state = nil

rs_downstream_hook_id = "#{Script.current.name}_downstream"
DownstreamHook.remove(rs_downstream_hook_id) rescue nil
DownstreamHook.add(rs_downstream_hook_id, proc do |server_string|
  RsPanel.observe_downstream(server_string)
  server_string
end)

rs_upstream_hook_id = "#{Script.current.name}_upstream"
UpstreamHook.remove(rs_upstream_hook_id) rescue nil
UpstreamHook.add(rs_upstream_hook_id, proc do |command|
  c = command.to_s.strip.sub(/\A<c>/i, '')
  if c =~ /\*rs\b/i
    RsPanel.pending_cmd = c
    nil
  else
    command
  end
end, persist: false)

_respond(RsPanel.open_dialog_xml)
pause 0.15
_respond(RsPanel.build_dialog)
RsPanel.last_state = RsPanel.state

before_dying do
  UpstreamHook.remove(rs_upstream_hook_id) rescue nil
  DownstreamHook.remove(rs_downstream_hook_id) rescue nil
  _respond("<closeDialog id='#{RsPanel::DIALOG_ID}'/>")
end

RsPanel.story_echo('rs lamp active (Radial Sweep READY). *rs help')

loop do
  if RsPanel.pending_cmd
    raw = RsPanel.pending_cmd
    RsPanel.pending_cmd = nil
    begin
      RsPanel.handle_command(raw).each { |line| RsPanel.story_echo(line) }
    rescue StandardError => e
      RsPanel.story_echo("rs error: #{e.message}")
    end
  end

  st = RsPanel.state
  if RsPanel.dirty || st != RsPanel.last_state
    RsPanel.dirty = false
    RsPanel.last_state = st
    _respond(RsPanel.build_dialog)
  end
  pause 0.2
end
