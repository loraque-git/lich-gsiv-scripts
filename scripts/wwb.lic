=begin

  Combat maneuver: Whirling Blade (weapon wblade). Stances offensive first.

  Usage:
    ;wwb                     - weapon wblade current/best target
    ;wwb <name>              - prefer a living NPC whose name matches

       creator: loraque (loraque@gmail.com)
        author: loraque (loraque@gmail.com)
          game: Gemstone
          tags: maneuver, combat, weapon
      required: Lich >= 5.12.0
       version: 0.9.0

  changelog:
    0.9.0 (2026-10-16)
      targeting: prefer oldest living foe (min gameobj id) over newest
    0.8.0 (2026-09-11)
      katana: retry grip one until the real 1H line; waitrt after the
        swing so grip two cannot outrun it; skip restore if ffl/wwb is
        still running; wait for a sibling wwb/ffl/www before gripping
    0.7.0 (2026-09-09)
      lock: kill stale same-name copy after 5s instead of overlapping
      action: re-check target is still living before the swing
      creator: loraque (loraque@gmail.com)
    0.6.2 (2026-09-09)
      stance: cap attempts; bail if dead/stunned/webbed; re-check target
    0.6.1 (2026-09-09)
      grip one whenever a katana/bastard is in the right hand; 2H grip does
        not fill the left-hand XML slot. Restore grip two only if we switched.
    0.6.0 (2026-09-09)
      two-handed katana/bastard: grip one before the swing, grip two after
    0.5.0 (2026-09-09)
      waitrt after targeting; waitcastrt?; re-check the same id is still living
    0.4.0 (2026-09-09)
      targeting: shared living-foe check; named miss exits; no random sample
    0.3.0 (2026-09-09)
      named BEGIN/END blocks: config, lock, waitrt, targeting, stance, action
    0.2.0 (2026-09-09)
      EO header and family tags
      Char.stance instead of checkstance
      nil-safe GameObj.target; Regexp.escape on name match
      Script.current.vars[0] for the full argument string
    0.1.0
      initial clone

=end

# BEGIN config
COMBAT_COMMAND = "weapon wblade"
STANCE_DANCE = true
# END config

# BEGIN lock
LOCK_TIMEOUT = 5.0

elapsed = 0.0
while (stale = Script.list.find { |s| s.name == Script.current.name && s != Script.current })
  pause 0.1
  elapsed += 0.1
  if elapsed >= LOCK_TIMEOUT
    stale.kill
    break
  end
end
# END lock

# BEGIN targeting
living_foe = lambda { |obj|
  obj && obj.id &&
    obj.status !~ /dead|gone/ &&
    obj.name !~ /^animated /
}

# Oldest living foe first (lowest gameobj id). FE dropdown / Array#find
# surface newest-first; numeric ids track arrival order more reliably.
oldest_living = lambda { |list|
  list.min_by { |obj| obj.id.to_i }
}

if dead? || checkstunned || checkwebbed
  echo "Cannot choose a target right now."
  exit
end

manual_input = Script.current.vars[0].to_s.strip
target_obj = nil

living = []
seen = {}
(GameObj.npcs + GameObj.targets).each do |obj|
  next unless living_foe.call(obj)
  next if seen[obj.id]
  seen[obj.id] = true
  living << obj
end

if !manual_input.empty?
  name_re = /#{Regexp.escape(manual_input)}/i
  matches = living.select { |obj| obj.name =~ name_re }
  target_obj = oldest_living.call(matches)
  unless target_obj
    echo "No living NPC matching #{manual_input.inspect}."
    exit
  end
else
  current_target = GameObj.target
  if living_foe.call(current_target)
    room_npc = GameObj.npcs.find { |npc| npc.id == current_target.id }
    target_obj = current_target if room_npc.nil? || living_foe.call(room_npc)
  end
  unless target_obj
    aggro = living.select { |obj| obj.type.to_s =~ /aggro|monster/ }
    target_obj = oldest_living.call(aggro)
  end
  target_obj ||= oldest_living.call(GameObj.targets.select { |obj| living_foe.call(obj) })
end

unless living_foe.call(target_obj)
  echo "No valid living targets found."
  exit
end

put "target ##{target_obj.id}" unless GameObj.target&.id == target_obj.id
# END targeting

# BEGIN waitrt
waitrt?
waitcastrt?
if target_obj.nil? || !target_obj.id ||
    target_obj.status =~ /dead|gone/ ||
    target_obj.name =~ /^animated /
  echo "Target is no longer valid."
  exit
end
# END waitrt

# BEGIN stance
if STANCE_DANCE
  stance_tries = 0
  while Char.stance !~ /^offensive$/i
    if dead? || checkstunned || checkwebbed
      echo "Cannot change stance right now."
      exit
    end
    stance_tries += 1
    if stance_tries > 8
      echo "Could not reach offensive stance."
      exit
    end
    fput "stance offensive"
  end
end

if target_obj.nil? || !target_obj.id ||
    target_obj.status =~ /dead|gone/ ||
    target_obj.name =~ /^animated /
  echo "Target is no longer valid."
  exit
end
# END stance

# BEGIN action
if target_obj.nil? || !target_obj.id ||
    target_obj.status =~ /dead|gone/ ||
    target_obj.name =~ /^animated /
  echo "Target is no longer valid."
  exit
end

right = GameObj.right_hand
hand_empty = lambda { |h| h.nil? || h.id.to_s.empty? || h.name.to_s.empty? || h.name =~ /^empty$/i }
katana_sibling = lambda {
  Script.list.any? { |s| s != Script.current && s.name =~ /^(wwb|ffl)$/ }
}

if hand_empty.call(right)
  echo "No weapon in the right hand."
  exit
end

if right.name.to_s =~ /katana|bastard/i
  elapsed = 0.0
  while Script.list.any? { |s| s != Script.current && s.name =~ /^(wwb|ffl|www)$/ }
    pause 0.1
    elapsed += 0.1
    break if elapsed >= 5.0
  end

  grip_ok = false
  switched_to_one = false
  12.times do
    waitrt?
    waitcastrt?
    if dead? || checkstunned || checkwebbed
      echo "Cannot change grip right now."
      exit
    end
    grip_line = fput("grip one").to_s
    if grip_line =~ /already gripping .+ with one hand/i
      grip_ok = true
      break
    elsif grip_line =~ /You grip .+ with one hand/i
      grip_ok = true
      switched_to_one = true
      break
    elsif grip_line =~ /\.\.\.wait/i
      pause 0.2
    else
      pause 0.15
    end
  end

  unless grip_ok
    echo "Could not switch to a one-handed grip."
    exit
  end

  if switched_to_one
    before_dying {
      unless katana_sibling.call
        waitrt?
        fput "grip two"
      end
    }
  end
end

if target_obj.nil? || !target_obj.id ||
    target_obj.status =~ /dead|gone/ ||
    target_obj.name =~ /^animated /
  echo "Target is no longer valid."
  exit
end

fput "#{COMBAT_COMMAND} ##{target_obj.id}"
waitrt?
# END action
