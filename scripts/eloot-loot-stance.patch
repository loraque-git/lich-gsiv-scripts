+  # BEGIN loot_stance patch
+  def self.loot_stance_name
+    name = ELoot.data.settings[:loot_stance].to_s.strip.downcase
+    return name if LOOT_STANCE_NAMES.include?(name)
+    # Legacy checkbox profiles that predate loot_stance.
