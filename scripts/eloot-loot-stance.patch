   def self.coerce_setting_value(setting_name, default, input)
+    # BEGIN loot_stance patch
+    if setting_name == :loot_stance
+      value = input.join(" ").strip.downcase
+      unless LOOT_STANCE_NAMES.include?(value)
+        ELoot.msg(type: "error", text: %{loot_stance must be one of: #{LOOT_STANCE_NAMES.join(', ')} (got "#{value}")})
+        exit
+      end
+      return value
+    end
+    # END loot_stance patch
