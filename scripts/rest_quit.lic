=begin

  Logs out after field XP is fully absorbed while you are idle/resting.

  Counts Saga EXPERIENCE pulses that show Field Exp 0 + "clear as a bell".
  After N such pulses (default 3) with no recent player commands, sends EXIT.

  Log review:
    2026-10-10 night (v0.1): gated on Saga "[Entering rest mode]" via get();
      those UI lines never arrived, so zero cycles counted through a long rest.
    2026-10-11 morning (v0.2): counted while actively hunting (cadence mode),
      then "pulse gap 155s > 90s" reset the counter when XP returned — never EXIT.
  v0.3: only count pulses while idle (no player cmds recently); ignore
    exp/experience as activity (Saga rest fires those); reset only when
    absorbing again; remove the gap wipe between clear pulses.

  Usage:
    ;rest_quit              - start watching
    ;rest_quit status       - show settings / mind / field
    ;rest_quit cycles N     - require N clear cycles before exit (default 3)
    ;rest_quit kill         - stop

       creator: loraque (loraque@gmail.com)
        author: loraque (loraque@gmail.com)
          game: Gemstone
          tags: rest, experience, logout, saga, utility
      required: Lich >= 5.12.0
       version: 0.3.0

  changelog:
    0.3.0 (2026-10-11)
      only count clear pulses while idle; UpstreamHook tracks activity
      ignore exp/experience commands (Saga rest auto-exp)
      reset counter only when absorbing; drop 90s gap wipe
      logout via exit (Saga) with quit fallback
    0.2.0 (2026-10-11)
      count EXPERIENCE pulses without requiring Saga enter lines
    0.1.0 (2026-10-10)
      initial

=end

REST_ENTER_RE = /Entering Saga rest mode/i
REST_LEAVE_RE = /Leaving Saga rest mode/i
FIELD_EXP_RE  = /Field Exp:\s*([\d,]+)\s*\/\s*([\d,]+)/
MIND_BELL_RE  = /Your mind is as clear as a bell\./i
MIND_STATE_RE = /Your mind (?:is as clear as a bell\.|is fresh and clear\.|is clear\.|is muddled\.|is becoming numbed\.|is numbed\.|can't take much more of this!|is completely saturated)/i

# Commands that do not count as "player activity" (Saga rest / panels fire these).
IGNORE_CMD_RE = /^(?:exp|experience|skill|skills|info|favor|resource|flag|society)\b/i

DEFAULT_CYCLES = 3
# Must have no real player commands for this long before a clear pulse counts.
IDLE_SECS = 45

def rq_echo(msg)
  echo msg
end

def rq_logout!
  rq_echo "logging out (exit)"
  begin
    do_client('exit')
  rescue StandardError
    nil
  end
  sleep 0.5
  begin
    fput 'exit'
  rescue StandardError
    nil
  end
  sleep 0.5
  begin
    do_client('quit')
  rescue StandardError
    nil
  end
  begin
    fput 'quit'
  rescue StandardError
    nil
  end
end

# --- CLI ---------------------------------------------------------------

if Script.current.vars[1].to_s =~ /^help$/i
  respond "Usage:"
  respond "  ;rest_quit              start watching"
  respond "  ;rest_quit status       show settings / mind / field"
  respond "  ;rest_quit cycles N     require N clear cycles before EXIT (default #{DEFAULT_CYCLES})"
  respond "  ;rest_quit kill         stop"
  exit
end

if Script.current.vars[1].to_s =~ /^kill$/i
  Script.kill('rest_quit') if Script.running?('rest_quit')
  exit
end

if Script.current.vars[1].to_s =~ /^cycles$/i
  n = Script.current.vars[2].to_i
  if n < 1
    respond "rest_quit: cycles must be >= 1 (got #{Script.current.vars[2].inspect})"
    exit
  end
  CharSettings['required_clear_cycles'] = n
  respond "rest_quit: will EXIT after #{n} clear-as-a-bell cycle(s)"
  exit
end

required = CharSettings['required_clear_cycles']
required = DEFAULT_CYCLES if required.nil? || required.to_i < 1
required = required.to_i

if Script.current.vars[1].to_s =~ /^status$/i
  respond "rest_quit: required clear cycles = #{required}"
  respond "rest_quit: mind=#{XMLData.mind_text.inspect} field=#{XMLData.field_exp}/#{XMLData.max_field_exp}"
  exit
end

clear_cycles  = 0
pending_field = nil
last_activity = Time.now # require a period of idleness after login before counting
rest_hint     = false

HOOK = 'rest_quit_activity'
UpstreamHook.add(HOOK, proc { |cmd|
  begin
    c = cmd.to_s.strip
    unless c.empty? || c =~ IGNORE_CMD_RE
      last_activity = Time.now
      if clear_cycles > 0
        clear_cycles = 0
        rq_echo "player command — clear counter reset"
      end
    end
  rescue StandardError
    nil
  end
  cmd
})

before_dying {
  UpstreamHook.remove(HOOK) rescue nil
  rq_echo "stopped"
}

rq_echo "watching v0.3 (EXIT after #{required} idle clear-as-a-bell pulse(s))"

loop do
  line = get
  now = Time.now
  idle_for = now - last_activity

  if line =~ REST_ENTER_RE
    rest_hint = true
    clear_cycles = 0
    pending_field = nil
    rq_echo "Saga rest enter seen — counter reset; need #{required}"
    next
  end

  if line =~ REST_LEAVE_RE
    rq_echo "Saga rest leave seen — counter reset (was #{clear_cycles}/#{required})"
    rest_hint = false
    clear_cycles = 0
    pending_field = nil
    next
  end

  # Player commands also appear on the game stream as ">verb ..."
  if line =~ /^>(\S+)/
    cmd = $1.to_s
    unless cmd.empty? || cmd =~ IGNORE_CMD_RE
      last_activity = now
      if clear_cycles > 0
        clear_cycles = 0
        rq_echo "player command (>#{cmd}) — clear counter reset"
      end
    end
  end

  if line =~ FIELD_EXP_RE
    pending_field = $1.delete(',').to_i
    next
  end

  next if pending_field.nil?
  next unless line =~ MIND_STATE_RE

  field = pending_field
  pending_field = nil
  bell = !!(line =~ MIND_BELL_RE)
  mind_txt = line.to_s.strip

  if field == 0 && bell
    if idle_for < IDLE_SECS
      rq_echo "clear pulse ignored (active #{idle_for.to_i}s ago; need #{IDLE_SECS}s idle)"
      next
    end
    clear_cycles += 1
    mode = rest_hint ? "rest-enter seen" : "idle #{idle_for.to_i}s"
    rq_echo "clear cycle #{clear_cycles}/#{required} (Field Exp 0, clear as a bell, #{mode})"
    if clear_cycles >= required
      rq_echo "no field XP left and #{required} idle clear cycle(s) done — EXIT"
      rq_logout!
      exit
    end
  else
    if clear_cycles > 0
      rq_echo "still absorbing (Field Exp #{field}, #{mind_txt}) — counter reset"
    else
      rq_echo "absorbing (Field Exp #{field}, #{mind_txt})"
    end
    clear_cycles = 0
  end
end
