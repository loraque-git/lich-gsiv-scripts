=begin
  saga_hl_sagapanel.lic

  Saga-only panel + commands to improve Saga custom text highlights safely.

  Flow (always):
    1. Read highlights from Saga prefs.json (does not write prefs while Saga runs)
    2. Backup under saga-hl-backups
    3. Apply standard package or individual improvers (panel toggles)
    4. Write saga-highlights.json (Import Settings file)
    5. Tell you how to Import in Saga, and how to restore if you dislike it

  In-game:
    ;saga-hl / ;saga_hl_sagapanel - Start the panel
    Panel: Instance tabs · Character dropdown · Improve · Apply/Backup/Write · Restore
    *hl help                    - Commands
    *hl status                  - Counts / paths
    *hl char <name|instance>    - Switch working character
    *hl instance <id>           - Prime / Test / …
    *hl set <improver> 0|1      - Checkbox-driven improver state
    *hl toggle <name>           - Flip an improver on/off
    *hl apply                   - Backup → enabled improvers → write import JSON
    *hl package                 - Enable standard package, then apply
    *hl backup                  - Snapshot only
    *hl write                   - Write import JSON from working set (no improvers)
    *hl restore <backup-id>     - Rewrite import JSON from that backup

  Outside the game (script source / local AI — NOT a panel action):
    See "Local AI / maintainer" at the end of this header.
    Improve one # BEGIN saga_hl/... block at a time; bump Version + changelog.

  Windows-first: prefs/backups under %APPDATA%\saga\; import JSON under %USERPROFILE%.

  Author: loraque (loraque@gmail.com)
  Required: Lich >= 5.12.0
  Tags: saga, frontend, panel, highlights, import
  Version: 0.3.0

  Recently changed:
    0.3.0 (2026-10-18)
      - Redesign: Instance tabs (Prime vs Test/other), Character dropdown,
        rule counts, native checkBox / cmdButton / dropDownBox, restore
        picker, coach line for next step. Still queues work on main loop.
    0.2.1 (2026-10-18)
      - Fix *hl never matching UpstreamHook: FE sends <c>*hl … and working
        panels match /\*cmd/ without \A. Strip <c> and match like *exp/*ah.
    0.2.0 (2026-10-18)
      - Fix dead panel clicks: queue *hl work on the script main loop
        (UpstreamHook only sets a flag; echo/_respond stay top-level).
      - Cleaner panel: header, live toggles, Apply / Backup / Write import.
        Hide unimplemented improvers until they ship.
    0.1.0 (2026-10-18)
      - Initial panel: read prefs, backup, dedupe improver, write import JSON,
        Import Settings + restore prompts. Windows/Linux paths.

  Local AI / maintainer (outside game):
    Block map — edit only the named region; keep markers intact:
      saga_hl/paths       OS paths, character key
      saga_hl/model       highlight/group hashes, richness, clone
      saga_hl/io          prefs read, import JSON write, JSON helpers
      saga_hl/backup      versioned backups + restore-to-import
      saga_hl/improve_dedupe
      saga_hl/pipeline    apply selected / standard package
      saga_hl/messaging   Import Settings + restore user copy
      saga_hl/panel       dialog XML + toggle state
      saga_hl/commands    *hl / ;saga-hl routing
    Do not change block markers. After edits: bump Version + Recently changed.
=end

no_kill_all

require 'json'
require 'fileutils'
require 'time'

# BEGIN saga_hl/paths
module SagaHl
  extend self
  include Lich::Common if defined?(Lich::Common)

  DIALOG_ID = 'SagaHlPanel'
  ROW_HEIGHT = 18
  DROP_HEIGHT = 24
  BTN_HEIGHT = 22
  PANEL_WIDTH = 360
  BACKUP_KEEP = 40
  RESTORE_PICK_LIMIT = 8
  IMPORT_BASENAME = 'saga-highlights.json'

  INSTANCE_TITLES = {
    'prime' => 'Prime',
    'test' => 'Test',
    'platinum' => 'Platinum',
    'shattered' => 'Shattered',
    'prime-copy' => 'Prime copy'
  }.freeze

  # id, label, default_on, implemented
  IMPROVERS = [
    [:dedupe, 'Dedupe exact', true, true],
    [:gender, 'Gender pairs', false, false],
    [:spellprep, 'Enemy spell prep', false, false],
    [:palette, 'Palette colors', false, false],
    [:group_styles, 'Empath/Cleric groups', false, false]
  ].freeze

  STANDARD_PACKAGE = [:dedupe].freeze

  class << self
    attr_accessor :toggles, :last_backup_id, :last_import_path, :last_status,
                  :working, :dirty, :char_key, :pending_cmd, :instance_filter,
                  :last_action
  end

  def self.windows?
    ENV['OS'].to_s =~ /windows/i || File::ALT_SEPARATOR == '\\' ||
      RUBY_PLATFORM.to_s =~ /mswin|mingw|cygwin/i
  end

  def self.user_home
    if windows?
      ENV['USERPROFILE'].to_s.strip.empty? ? Dir.home : ENV['USERPROFILE']
    else
      Dir.home
    end
  end

  def self.saga_config_dir
    if windows?
      appdata = ENV['APPDATA'].to_s.strip
      base = appdata.empty? ? File.join(user_home, 'AppData', 'Roaming') : appdata
      File.join(base, 'saga')
    else
      File.join(user_home, '.config', 'saga')
    end
  end

  def self.prefs_path
    File.join(saga_config_dir, 'prefs.json')
  end

  def self.backup_root
    File.join(saga_config_dir, 'saga-hl-backups')
  end

  def self.import_path
    File.join(user_home, IMPORT_BASENAME)
  end

  def self.char_name
    if defined?(Char) && Char.respond_to?(:name) && !Char.name.to_s.strip.empty?
      Char.name.to_s.strip
    elsif defined?(XMLData) && XMLData.respond_to?(:name) && !XMLData.name.to_s.strip.empty?
      XMLData.name.to_s.strip
    else
      'unknown'
    end
  end

  def self.normalize_char_key(raw)
    s = raw.to_s.strip.downcase
    return s if s.include?('|')
    "#{s}|prime"
  end

  def self.detect_char_key
    name = char_name.downcase
    prefs = read_prefs_hash
    keys = (prefs['characterSettings'] || {}).keys.map(&:to_s)
    matches = keys.select { |k| k.downcase.start_with?("#{name}|") }
    return matches.first if matches.size == 1
    return "#{name}|prime" if matches.any? { |k| k.downcase == "#{name}|prime" }
    return matches.first if matches.any?
    normalize_char_key(name)
  end

  def self.char_slug(key = nil)
    normalize_char_key(key || char_key || detect_char_key).tr('|', '-')
  end

  def self.split_char_key(key)
    name, inst = normalize_char_key(key).split('|', 2)
    [name.to_s, (inst.nil? || inst.empty?) ? 'prime' : inst]
  end

  def self.pretty_char_name(key)
    name, _inst = split_char_key(key)
    return name if name.empty?
    name[0].upcase + name[1..]
  end

  def self.pretty_instance(inst)
    INSTANCE_TITLES[inst.to_s.downcase] || inst.to_s.split(/[-_]/).map { |p| p[0].upcase + p[1..] }.join(' ')
  end

  def self.list_character_keys
    (read_prefs_hash['characterSettings'] || {}).keys.map(&:to_s).sort_by(&:downcase)
  end

  def self.rule_count_for(key)
    prefs = read_prefs_hash
    cs = prefs['characterSettings'] || {}
    hit = cs.keys.find { |k| k.to_s.downcase == key.to_s.downcase }
    rec = hit ? cs[hit] : {}
    ((rec['customHighlights'] || []).size)
  end

  def self.group_count_for(key)
    prefs = read_prefs_hash
    cs = prefs['characterSettings'] || {}
    hit = cs.keys.find { |k| k.to_s.downcase == key.to_s.downcase }
    rec = hit ? cs[hit] : {}
    ((rec['highlightGroups'] || []).size)
  end

  def self.characters_by_instance
    list_character_keys.group_by { |k| split_char_key(k)[1] }
  end

  def self.instance_order
    known = INSTANCE_TITLES.keys
    present = characters_by_instance.keys
    (known & present) + (present - known).sort
  end

  def self.ensure_instance_filter!
    if instance_filter.to_s.empty?
      _n, inst = split_char_key(char_key || detect_char_key)
      self.instance_filter = inst
    end
    instance_filter
  end
end
# END saga_hl/paths

# BEGIN saga_hl/model
module SagaHl
  def self.hl_richness(h)
    score = 0
    score += 1 if h['bold']
    score += 1 if h['italic']
    score += 1 if h['underline']
    score += 1 if h['notify']
    score += 1 if h['sound'].to_s.strip != ''
    score += 1 if h['regex']
    score += 1 if h['groupId'].to_s.strip != ''
    score
  end

  def self.clone_set(set)
    {
      'character' => set['character'],
      'highlights' => (set['highlights'] || []).map { |h| h.dup },
      'groups' => (set['groups'] || []).map { |g| g.dup }
    }
  end

  def self.empty_set(character)
    { 'character' => character, 'highlights' => [], 'groups' => [] }
  end

  def self.group_name(set, group_id)
    return '' if group_id.to_s.empty?
    g = (set['groups'] || []).find { |x| x['id'] == group_id }
    g ? g['name'].to_s : group_id.to_s
  end
end
# END saga_hl/model

# BEGIN saga_hl/io
module SagaHl
  def self.read_json_file(path)
    JSON.parse(File.read(path))
  end

  def self.write_json_file(path, data)
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, JSON.pretty_generate(data) + "\n")
  end

  def self.read_prefs_hash
    path = prefs_path
    return {} unless File.file?(path)
    read_json_file(path)
  rescue StandardError => e
    self.last_status = "prefs read failed: #{e.message}"
    {}
  end

  def self.load_set_from_prefs(key = nil)
    key = normalize_char_key(key || detect_char_key)
    self.char_key = key
    prefs = read_prefs_hash
    cs_all = prefs['characterSettings'] || {}
    cs = cs_all[key] || cs_all[key.downcase] || {}
    # try case-insensitive key match
    if cs.empty?
      hit = cs_all.keys.find { |k| k.to_s.downcase == key.downcase }
      cs = cs_all[hit] || {}
    end
    {
      'character' => key,
      'highlights' => (cs['customHighlights'] || []).map { |h| stringify_keys(h) },
      'groups' => (cs['highlightGroups'] || []).map { |g| stringify_keys(g) }
    }
  end

  def self.stringify_keys(hash)
    out = {}
    (hash || {}).each { |k, v| out[k.to_s] = v }
    out
  end

  def self.to_saga_import(set)
    key = set['character']
    {
      'kind' => 'saga-settings',
      'version' => 1,
      'exportedAt' => Time.now.utc.strftime('%Y-%m-%dT%H:%M:%S.000Z'),
      'character' => key,
      'categories' => ['highlights'],
      'characterSettings' => {
        'customHighlights' => set['highlights'],
        'highlightGroups' => set['groups']
      },
      'globals' => {}
    }
  end

  def self.write_import(set, path = nil)
    path ||= import_path
    write_json_file(path, to_saga_import(set))
    self.last_import_path = path
    path
  end
end
# END saga_hl/io

# BEGIN saga_hl/backup
module SagaHl
  def self.save_backup(set, reason: 'snapshot')
    stamp = Time.now.strftime('%Y%m%d-%H%M%S')
    safe = reason.to_s.gsub(/[^a-zA-Z0-9._-]+/, '-')[0, 48]
    safe = 'snapshot' if safe.empty?
    dir = File.join(backup_root, char_slug(set['character']), "#{stamp}_#{safe}")
    n = 2
    while File.exist?(dir)
      dir = File.join(backup_root, char_slug(set['character']), "#{stamp}_#{safe}-#{n}")
      n += 1
    end
    FileUtils.mkdir_p(dir)
    import_file = File.join(dir, 'import.json')
    write_json_file(import_file, to_saga_import(set))
    manifest = {
      'kind' => 'saga-hl-backup',
      'version' => 1,
      'character' => set['character'],
      'reason' => reason,
      'createdAt' => Time.now.utc.iso8601,
      'highlightCount' => (set['highlights'] || []).size,
      'groupCount' => (set['groups'] || []).size
    }
    write_json_file(File.join(dir, 'manifest.json'), manifest)
    self.last_backup_id = File.basename(dir)
    last_backup_id
  end

  def self.list_backups(key = nil)
    root = File.join(backup_root, char_slug(key))
    return [] unless File.directory?(root)
    Dir.children(root).sort.reverse.filter_map do |name|
      man = File.join(root, name, 'manifest.json')
      next unless File.file?(man)
      begin
        m = read_json_file(man)
        { 'id' => name, 'reason' => m['reason'], 'highlightCount' => m['highlightCount'] }
      rescue StandardError
        { 'id' => name, 'reason' => '', 'highlightCount' => nil }
      end
    end
  end

  def self.backup_import_path(backup_id, key = nil)
    File.join(backup_root, char_slug(key), backup_id, 'import.json')
  end

  def self.restore_backup_to_import(backup_id, key = nil)
    src = backup_import_path(backup_id, key)
    raise "backup not found: #{backup_id}" unless File.file?(src)
    data = read_json_file(src)
    path = write_import(
      {
        'character' => (data['character'] || key || char_key),
        'highlights' => (((data['characterSettings'] || {})['customHighlights']) || []),
        'groups' => (((data['characterSettings'] || {})['highlightGroups']) || [])
      }
    )
    path
  end
end
# END saga_hl/backup

# BEGIN saga_hl/improve_dedupe
module SagaHl
  # Exact pattern duplicates only. Keeps richest / enabled rule.
  # Local AI: extend carefully; do not delete near-dupes here.
  def self.improve_dedupe(set)
    by = Hash.new { |h, k| h[k] = [] }
    (set['highlights'] || []).each { |h| by[h['pattern'].to_s] << h }
    keep_ids = {}
    removed = 0
    by.each_value do |items|
      if items.size == 1
        keep_ids[items[0]['id']] = true
        next
      end
      ranked = items.sort_by { |h| [hl_richness(h), h['enabled'] ? 1 : 0] }.reverse
      keep_ids[ranked[0]['id']] = true
      removed += items.size - 1
    end
    set['highlights'] = (set['highlights'] || []).select { |h| keep_ids[h['id']] }
    { 'removed' => removed }
  end
end
# END saga_hl/improve_dedupe

# BEGIN saga_hl/pipeline
module SagaHl
  def self.ensure_toggles!
    self.toggles ||= {}
    IMPROVERS.each do |id, _label, default_on, _impl|
      toggles[id] = default_on unless toggles.key?(id)
    end
  end

  def self.improver_row(id)
    IMPROVERS.find { |i, _, _, _| i == id }
  end

  def self.implemented_improvers
    IMPROVERS.select { |_, _, _, impl| impl }
  end

  def self.toggle!(name)
    ensure_toggles!
    key = name.to_s.downcase.tr(' ', '_').to_sym
    key = :dedupe if key == :dedupe_exact
    row = improver_row(key)
    unless row
      raise "unknown improver #{name.inspect} — try: #{implemented_improvers.map { |i, _, _, _| i }.join(', ')}"
    end
    unless row[3]
      toggles[key] = false
      raise "#{key} is not implemented yet"
    end
    toggles[key] = !toggles[key]
    toggles[key]
  end

  def self.set_improver!(name, on)
    ensure_toggles!
    key = name.to_s.downcase.tr(' ', '_').to_sym
    key = :dedupe if key == :dedupe_exact
    row = improver_row(key)
    unless row
      raise "unknown improver #{name.inspect}"
    end
    unless row[3]
      toggles[key] = false
      raise "#{key} is not implemented yet"
    end
    toggles[key] = !!on
    toggles[key]
  end

  def self.select_character!(raw_key)
    key = normalize_char_key(raw_key)
    self.char_key = key
    _n, inst = split_char_key(key)
    self.instance_filter = inst
    self.working = load_set_from_prefs(key)
    n = (working['highlights'] || []).size
    self.last_status = "selected #{pretty_char_name(key)} · #{pretty_instance(inst)} · #{n} rules"
    self.last_action = :char
    self.dirty = true
    key
  end

  def self.select_instance!(raw_inst)
    inst = raw_inst.to_s.strip.downcase
    raise "unknown instance #{raw_inst.inspect}" if inst.empty?
    self.instance_filter = inst
    keys = characters_by_instance[inst] || []
    if keys.empty?
      self.last_status = "no characters on #{pretty_instance(inst)}"
    elsif char_key && split_char_key(char_key)[1] == inst
      self.last_status = "instance #{pretty_instance(inst)}"
    else
      # Prefer the logged-in name on that instance, else the richest ruleset.
      want = char_name.downcase
      pick = keys.find { |k| split_char_key(k)[0] == want }
      pick ||= keys.max_by { |k| rule_count_for(k) }
      select_character!(pick) if pick
      self.last_status = "instance #{pretty_instance(inst)}"
    end
    self.last_action = :instance
    self.dirty = true
    inst
  end

  def self.enable_standard_package!
    ensure_toggles!
    IMPROVERS.each { |id, _, _, _| toggles[id] = false }
    STANDARD_PACKAGE.each { |id| toggles[id] = true }
  end

  def self.run_improver(id, set)
    case id
    when :dedupe
      improve_dedupe(set)
    else
      { 'skipped' => true, 'reason' => 'not implemented' }
    end
  end

  def self.apply_pipeline(mode: :selected)
    ensure_toggles!
    enable_standard_package! if mode == :package

    before = load_set_from_prefs(char_key || detect_char_key)
    self.working = clone_set(before)
    bak = save_backup(before, reason: mode == :package ? 'before-package' : 'before-apply')

    results = {}
    IMPROVERS.each do |id, label, _, impl|
      next unless toggles[id]
      next unless impl
      results[id.to_s] = run_improver(id, working).merge('label' => label)
    end

    path = write_import(working)
    self.last_status = "applied · backup #{bak} · #{(working['highlights'] || []).size} rules"
    self.dirty = true
    {
      'backup' => bak,
      'importPath' => path,
      'count' => (working['highlights'] || []).size,
      'beforeCount' => (before['highlights'] || []).size,
      'results' => results
    }
  end
end
# END saga_hl/pipeline

# BEGIN saga_hl/messaging
module SagaHl
  def self.import_restore_lines(info)
    path = info['importPath'] || last_import_path || import_path
    bak = info['backup'] || last_backup_id
    [
      '--- saga-hl: next steps ---',
      "1. Wrote #{path}",
      '2. Saga → Import Settings → Custom highlights → that file',
      "3. Undo: pick a backup in the panel (or *hl restore #{bak})",
      '---------------------------'
    ]
  end

  def self.coach_line
    set = working || empty_set(char_key || detect_char_key)
    n = (set['highlights'] || []).size
    case last_action
    when :apply, :package, :write
      "Next: Saga → Import Settings → #{IMPORT_BASENAME}"
    when :backup
      'Snapshot saved. Apply when you want a new import file.'
    when :restore
      'Backup copied to import file. Import Settings to load it.'
    when :char, :instance
      n.zero? ? 'This character has no custom highlights yet.' : "Editing #{pretty_char_name(char_key)} · #{n} rules"
    else
      if last_backup_id.to_s.empty?
        'Tip: Backup first — safe snapshot before you change anything.'
      elsif n.zero?
        'Empty set — pick another character or import from the web tool.'
      else
        'Ready. Apply runs enabled improvers → writes import JSON.'
      end
    end
  end

  def self.status_lines
    ensure_toggles!
    ensure_instance_filter!
    set = working || load_set_from_prefs
    self.char_key ||= set['character']
    name, inst = split_char_key(char_key)
    lines = [
      "saga-hl  #{pretty_char_name(char_key)}  ·  #{pretty_instance(inst)}  ·  #{(set['highlights'] || []).size} rules",
      "  key: #{char_key}",
      "  import: #{last_import_path || import_path}",
      "  last backup: #{last_backup_id || '(none)'}"
    ]
    implemented_improvers.each do |id, label, _, _|
      on = toggles[id] ? 'ON' : 'off'
      lines << "  [#{on}] #{label}"
    end
    lines << "  #{last_status}" if last_status.to_s != ''
    lines << "  coach: #{coach_line}"
    lines
  end
end
# END saga_hl/messaging

# BEGIN saga_hl/panel
module SagaHl
  def self.sanitize_xml(value)
    value.to_s.gsub('&', '&amp;').gsub('<', '&lt;').gsub('>', '&gt;').gsub("'", '&apos;').gsub('"', '&quot;')
  end

  # dropDownBox splits content_* on commas — never put commas in labels/values.
  def self.dropdown_safe(text)
    text.to_s.tr(',', ' ').gsub(/\s+/, ' ').strip
  end

  def self.open_dialog_xml
    "<closeDialog id='#{DIALOG_ID}'/><openDialog type='dynamic' id='#{DIALOG_ID}' title='saga-hl' target='#{DIALOG_ID}' scroll='manual' location='main' resident='true'><dialogData id='#{DIALOG_ID}'></dialogData></openDialog>"
  end

  def self.widget(tag, attrs)
    parts = attrs.map { |k, v| "#{k}='#{sanitize_xml(v)}'" }
    "<#{tag} #{parts.join(' ')} />"
  end

  def self.build_dialog
    ensure_toggles!
    ensure_instance_filter!
    set = working || (begin
      load_set_from_prefs
    rescue StandardError
      empty_set(detect_char_key)
    end)
    self.char_key ||= set['character']
    name, inst = split_char_key(char_key)
    rules = (set['highlights'] || []).size
    groups = (set['groups'] || []).size

    out = String.new("<dialogData id='#{DIALOG_ID}' clear='t'>")
    y = 0
    w = PANEL_WIDTH

    # Title
    out << widget('label', id: 'hl_title', value: 'saga-hl', left: 2, top: y, width: w, height: ROW_HEIGHT)
    y += ROW_HEIGHT + 2

    # Instance tabs — Prime first, then everything else (Test / specials)
    out << widget('label', id: 'hl_inst_lbl', value: 'Instance', left: 2, top: y, width: 64, height: ROW_HEIGHT)
    x = 70
    instance_order.each_with_index do |iid, idx|
      title = pretty_instance(iid)
      mark = (iid == instance_filter) ? "[{#{title}}]" : "[ #{title} ]"
      out << widget('link', id: "hl_inst_#{idx}", value: mark, cmd: "*hl instance #{iid}",
                            left: x, top: y, width: 78, height: ROW_HEIGHT)
      x += 80
    end
    y += ROW_HEIGHT + 4

    # Character dropdown (filtered to selected instance)
    keys = characters_by_instance[instance_filter] || []
    keys = list_character_keys if keys.empty?
    labels = keys.map do |k|
      n = rule_count_for(k)
      dropdown_safe("#{pretty_char_name(k)} · #{n}")
    end
    values = keys.map { |k| dropdown_safe(k) }
    selected_label = begin
      i = keys.index { |k| k.downcase == char_key.to_s.downcase } || 0
      labels[i] || labels[0] || dropdown_safe(pretty_char_name(char_key))
    end
    out << widget('label', id: 'hl_char_lbl', value: 'Character', left: 2, top: y + 2, width: 64, height: DROP_HEIGHT)
    out << widget('dropDownBox',
                  id: 'hl_char',
                  value: selected_label,
                  content_text: labels.join(','),
                  content_value: values.join(','),
                  cmd: '*hl char %hl_char%',
                  left: 70, top: y, width: w - 72, height: DROP_HEIGHT)
    y += DROP_HEIGHT + 2

    # Stats — name and instance split, no raw key in the main chrome
    out << widget('label', id: 'hl_stats',
                  value: "#{pretty_char_name(char_key)}  ·  #{pretty_instance(inst)}  ·  #{rules} rules  ·  #{groups} groups",
                  left: 2, top: y, width: w, height: ROW_HEIGHT)
    y += ROW_HEIGHT + 6

    # Improvers
    out << widget('label', id: 'hl_imp_hdr', value: '— Improve —', left: 2, top: y, width: w, height: ROW_HEIGHT)
    y += ROW_HEIGHT
    implemented_improvers.each do |id, label, _, _|
      checked = toggles[id] ? '1' : '0'
      out << widget('checkBox',
                    id: "hl_imp_#{id}",
                    text: label,
                    checked: checked,
                    checked_value: '1',
                    unchecked_value: '0',
                    cmd: "*hl set #{id} %hl_imp_#{id}%",
                    left: 8, top: y, width: w - 10, height: ROW_HEIGHT)
      y += ROW_HEIGHT
    end
    # Coming-soon as quiet labels (discoverable, not clickable noise)
    soon = IMPROVERS.reject { |_, _, _, impl| impl }.map { |_, lab, _, _| lab }
    unless soon.empty?
      out << widget('label', id: 'hl_soon', value: "Soon: #{soon.join(' · ')}",
                    left: 8, top: y, width: w - 10, height: ROW_HEIGHT)
      y += ROW_HEIGHT
    end
    y += 4

    # Actions
    out << widget('label', id: 'hl_act_hdr', value: '— Do —', left: 2, top: y, width: w, height: ROW_HEIGHT)
    y += ROW_HEIGHT
    btn_w = 108
    out << widget('cmdButton', id: 'hl_apply', value: 'Apply', cmd: '*hl apply',
                  left: 2, top: y, width: btn_w, height: BTN_HEIGHT)
    out << widget('cmdButton', id: 'hl_backup', value: 'Backup', cmd: '*hl backup',
                  left: 2 + btn_w + 6, top: y, width: btn_w, height: BTN_HEIGHT)
    out << widget('cmdButton', id: 'hl_write', value: 'Write import', cmd: '*hl write',
                  left: 2 + (btn_w + 6) * 2, top: y, width: btn_w, height: BTN_HEIGHT)
    y += BTN_HEIGHT + 6

    # Restore picker
    out << widget('label', id: 'hl_undo_hdr', value: '— Undo —', left: 2, top: y, width: w, height: ROW_HEIGHT)
    y += ROW_HEIGHT
    backups = begin
      list_backups(char_key).first(RESTORE_PICK_LIMIT)
    rescue StandardError
      []
    end
    if backups.empty?
      out << widget('label', id: 'hl_nobak', value: 'No backups yet for this character.',
                    left: 8, top: y, width: w - 10, height: ROW_HEIGHT)
      y += ROW_HEIGHT
    else
      blabels = backups.map do |b|
        id = b['id'].to_s
        # 20261018-092205_write-import-web → 10-18 write-import
        short = id.sub(/\A(\d{4})(\d{2})(\d{2})-(\d{2})(\d{2})(\d{2})_/) { "#{Regexp.last_match(2)}-#{Regexp.last_match(3)} " }
        short = short.split('_').first(2).join(' ')
        n = b['highlightCount']
        dropdown_safe(n ? "#{short} (#{n})" : short)
      end
      bvalues = backups.map { |b| dropdown_safe(b['id']) }
      out << widget('dropDownBox',
                    id: 'hl_restore',
                    value: blabels[0],
                    content_text: blabels.join(','),
                    content_value: bvalues.join(','),
                    cmd: '*hl restore %hl_restore%',
                    left: 2, top: y, width: w - 4, height: DROP_HEIGHT)
      y += DROP_HEIGHT
    end
    y += 6

    # Coach + status
    out << widget('label', id: 'hl_sep', value: '——————————————', left: 2, top: y, width: w, height: ROW_HEIGHT)
    y += ROW_HEIGHT
    out << widget('label', id: 'hl_coach', value: coach_line, left: 2, top: y, width: w, height: ROW_HEIGHT)
    y += ROW_HEIGHT
    note = last_status.to_s.empty? ? 'Ready.' : last_status.to_s
    out << widget('label', id: 'hl_note', value: note, left: 2, top: y, width: w, height: ROW_HEIGHT)

    out << '</dialogData>'
    out
  end
end
# END saga_hl/panel

# BEGIN saga_hl/commands
module SagaHl
  # Pure work + message list. No echo/_respond here — boot loop does that.
  # Sets dirty when the panel should redraw.
  def self.handle_command(raw)
    cmd = raw.to_s.strip.sub(/\A<c>/i, '')
    cmd = cmd.sub(/\A;?saga[_-]?hl\s+/i, '').sub(/\A\*hl\s+/i, '')
    cmd = 'help' if cmd.empty? || cmd =~ /\Ahelp\z/i
    msgs = []

    case cmd
    when /\Ahelp\z/i
      msgs.concat([
        'saga-hl panel:',
        '  Instance tabs · Character dropdown · Improve checkboxes',
        '  Apply / Backup / Write import · Restore dropdown',
        '  *hl status | *hl char <name|instance> | *hl instance <id>',
        '  *hl set <improver> 0|1 | *hl toggle <improver>',
        '  *hl apply | *hl package | *hl backup | *hl write | *hl restore <id>',
        "  live improvers: #{implemented_improvers.map { |i, _, _, _| i }.join(', ')}"
      ])
    when /\Astatus\z/i
      msgs.concat(status_lines)
      self.dirty = true
    when /\Achar\s+(\S+)\z/i
      begin
        select_character!(Regexp.last_match(1))
        msgs << "saga-hl: #{last_status}"
      rescue StandardError => e
        msgs << "saga-hl char failed: #{e.message}"
      end
      self.dirty = true
    when /\Ainstance\s+(\S+)\z/i
      begin
        select_instance!(Regexp.last_match(1))
        msgs << "saga-hl: #{last_status}"
      rescue StandardError => e
        msgs << "saga-hl instance failed: #{e.message}"
      end
      self.dirty = true
    when /\Aset\s+(\S+)\s+(\S+)\z/i
      begin
        name = Regexp.last_match(1)
        raw = Regexp.last_match(2).downcase
        on = %w[1 true on yes].include?(raw)
        set_improver!(name, on)
        msgs << "saga-hl: #{name} → #{on ? 'ON' : 'off'}"
      rescue StandardError => e
        msgs << "saga-hl: #{e.message}"
      end
      self.dirty = true
    when /\Atoggle\s+(\S+)\z/i
      begin
        name = Regexp.last_match(1)
        on = toggle!(name)
        msgs << "saga-hl: #{name} → #{on ? 'ON' : 'off'}"
      rescue StandardError => e
        msgs << "saga-hl: #{e.message}"
      end
      self.dirty = true
    when /\Aapply\z/i
      begin
        info = apply_pipeline(mode: :selected)
        self.last_action = :apply
        msgs << "saga-hl: #{last_status}"
        msgs.concat(import_restore_lines(info))
      rescue StandardError => e
        msgs << "saga-hl apply failed: #{e.message}"
      end
      self.dirty = true
    when /\Apackage\z/i
      begin
        info = apply_pipeline(mode: :package)
        self.last_action = :package
        msgs << "saga-hl: #{last_status}"
        msgs.concat(import_restore_lines(info))
      rescue StandardError => e
        msgs << "saga-hl package failed: #{e.message}"
      end
      self.dirty = true
    when /\Abackup\z/i
      begin
        set = working || load_set_from_prefs
        bak = save_backup(set, reason: 'manual')
        self.last_action = :backup
        self.last_status = "backup #{bak} (#{(set['highlights'] || []).size} rules)"
        msgs << "saga-hl: #{last_status}"
      rescue StandardError => e
        msgs << "saga-hl backup failed: #{e.message}"
      end
      self.dirty = true
    when /\Awrite\z/i
      begin
        set = working || load_set_from_prefs
        path = write_import(set)
        self.last_action = :write
        self.last_status = "wrote #{File.basename(path)} (#{(set['highlights'] || []).size} rules)"
        msgs << "saga-hl: #{last_status}"
        msgs.concat(import_restore_lines('importPath' => path, 'backup' => last_backup_id || '(backup first)'))
      rescue StandardError => e
        msgs << "saga-hl write failed: #{e.message}"
      end
      self.dirty = true
    when /\Arestore\s+(\S+)\z/i
      begin
        bid = Regexp.last_match(1)
        path = restore_backup_to_import(bid)
        self.last_action = :restore
        self.last_status = "restored #{bid}"
        msgs << "saga-hl: #{last_status} → #{path}"
        msgs << 'Saga → Import Settings → Custom highlights → that file.'
      rescue StandardError => e
        msgs << "saga-hl restore failed: #{e.message}"
      end
      self.dirty = true
    else
      msgs << "saga-hl: unknown #{cmd.inspect} — *hl help"
    end
    msgs
  end
end
# END saga_hl/commands

# --- boot ---
# UpstreamHook only queues. File I/O + echo/_respond run on this script's
# main loop (same pattern as exp_sagapanel's heavy *exp refresh / importlogs).
# If the hook raises, Lich removes it — so keep the hook trivial.
SagaHl.ensure_toggles!
SagaHl.dirty = false
SagaHl.pending_cmd = nil
SagaHl.last_action = nil
begin
  SagaHl.working = SagaHl.load_set_from_prefs
  SagaHl.char_key ||= SagaHl.working['character']
  SagaHl.ensure_instance_filter!
  name, inst = SagaHl.split_char_key(SagaHl.char_key)
  SagaHl.last_status = "loaded #{SagaHl.pretty_char_name(SagaHl.char_key)} · #{SagaHl.pretty_instance(inst)} · #{(SagaHl.working['highlights'] || []).size} rules"
rescue StandardError => e
  SagaHl.last_status = "load failed: #{e.message}"
  SagaHl.working = SagaHl.empty_set(SagaHl.detect_char_key)
  SagaHl.char_key = SagaHl.working['character']
  SagaHl.ensure_instance_filter!
end

# Match like exp/alsohere/timers: no \A anchor. Saga/FE often prefixes <c>.
hl_upstream_hook_id = "#{Script.current.name}_upstream"
UpstreamHook.remove(hl_upstream_hook_id) rescue nil
UpstreamHook.add(hl_upstream_hook_id, proc do |command|
  c = command.to_s.strip.sub(/\A<c>/i, '')
  if c =~ /\*hl\b/i || c =~ /;?saga[_-]?hl\b/i
    SagaHl.pending_cmd = c
    nil
  else
    command
  end
end, persist: false)

_respond(SagaHl.open_dialog_xml)
pause 0.2
_respond(SagaHl.build_dialog)

before_dying do
  UpstreamHook.remove(hl_upstream_hook_id) rescue nil
  _respond("<closeDialog id='#{SagaHl::DIALOG_ID}'/>")
end

echo "saga-hl panel active. Click Apply / Backup / Write import, or *hl help."
SagaHl.status_lines.each { |l| echo l }

loop do
  if SagaHl.pending_cmd
    raw = SagaHl.pending_cmd
    SagaHl.pending_cmd = nil
    begin
      SagaHl.handle_command(raw).each { |line| echo line }
    rescue StandardError => e
      echo "saga-hl error: #{e.message}"
    end
  end
  if SagaHl.dirty
    SagaHl.dirty = false
    _respond(SagaHl.build_dialog)
  end
  pause 0.2
end
